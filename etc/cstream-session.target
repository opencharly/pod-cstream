[Unit]
# The lifetime a nested cstream desktop belongs to.
#
# The compositor and the streamer are meaningless outside a session: Hyprland
# nests into a parent Wayland display and aborts without one. Binding them to
# this target rather than to multi-user.target is what stops the deploy from
# starting a compositor that has nothing to attach to -- measured in
# pod-hyprland#5, where the unit rendered, was enabled into multi-user.target,
# started at deploy time, and failed because the streamer was not installed yet.
#
# Not `WantedBy=multi-user.target` here either: a target that pulls itself in at
# boot would re-create exactly that problem one level up.
Description=cstream desktop session
