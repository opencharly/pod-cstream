[Unit]
# The lifetime a nested cstream desktop belongs to.
#
# The nested desktop and the streamer are meaningless outside a session: the
# desktop's compositor nests into the streamer's Wayland display and has nothing
# to attach to without it. Binding them to this target rather than to
# multi-user.target is what stops the deploy from starting a compositor before
# its parent exists -- measured on a systemd venue, where a unit enabled into
# multi-user.target started at deploy time and failed because the streamer was
# not installed yet.
#
# Not `WantedBy=multi-user.target` here either: a target that pulls itself in at
# boot would re-create exactly that problem one level up.
Description=cstream desktop session
