#!/bin/bash
# frame-probe — pull a frame back THROUGH the negotiated WebRTC track.
#
# This is the probe the cstream: verb ultimately exists for, and it is NOT the
# same assertion as stream-probe:
#
#   * stream-probe reads the TAP on the producer's own pipeline
#     (/tmp/cstream-frames). It proves the compositor and encoder produce
#     changing content, and says nothing about whether any of it leaves the
#     process.
#   * wl: screenshot reads the COMPOSITOR. It cannot fail on an encoding or
#     transport defect at all.
#   * this probe decodes what a real consumer receives over WebRTC, so it fails
#     on a broken encoder, a broken negotiation, or a broken transport --
#     the class of defect the other two structurally cannot see.
#
# The defect it was written for is on record: gst-plugins-bad was missing, so
# webrtcbin did not exist, and webrtcsink failed to build its session pipeline
# with a WARN (`Failed to make element webrtcbin`). Every producer-side check
# passed while not one byte of media reached a consumer.
set -u

OUT=${1:?usage: frame-probe <output-path>}
SIGNALLING=${CSTREAM_SIGNALLING_URI:-ws://127.0.0.1:8443}
# Long enough for negotiation plus a keyframe, short enough that a dead stream
# fails the step rather than hanging the bed. This is a BOUND on a real wait,
# not a sleep: the loop below exits as soon as a frame lands.
DEADLINE=${CSTREAM_FRAME_TIMEOUT:-40}

# charly's command: check does not surface stdout on failure, so the probe keeps
# a transcript. Without it the only signal is "exit=1" and the cause has to be
# guessed from outside the bed.
exec > >(tee -a /tmp/frame-probe.log) 2>&1
echo "=== frame-probe $(date -u +%H:%M:%S) -> $OUT ==="

WORK=$(mktemp -d /tmp/frame-probe.XXXXXX)
trap 'rm -rf "$WORK"' EXIT

# Self-diagnosis: this probe runs under charly's in_container exec, which differs
# from an interactive shell in uid and environment. Name the context rather than
# leave a failure to be reproduced by hand.
echo "FRAME-CTX: uid=$(id -u 2>/dev/null) signalling=$SIGNALLING deadline=${DEADLINE}s"
echo "FRAME-CTX: webrtcbin=$(gst-inspect-1.0 webrtcbin >/dev/null 2>&1 && echo present || echo MISSING)"
echo "FRAME-CTX: webrtcsrc=$(gst-inspect-1.0 webrtcsrc >/dev/null 2>&1 && echo present || echo MISSING)"

# webrtcbin is what webrtcsink builds PER SESSION. Without it the session starts
# and no media ever follows, with no ICE or DTLS error -- so name it here rather
# than letting the probe time out with a generic "no frames".
if ! gst-inspect-1.0 webrtcbin >/dev/null 2>&1; then
    echo "FRAME-FAIL: webrtcbin is missing (gst-plugins-bad not installed) --"
    echo "            webrtcsink cannot build a session pipeline, so no media can flow."
    exit 1
fi

# connect-to-first-producer defaults to FALSE. Without it the consumer connects
# to signalling and waits forever for a peer-id nobody supplies: no error, no
# frame, a timeout indistinguishable from a dead stream.
timeout "$DEADLINE" gst-launch-1.0 -q \
    webrtcsrc signaller::uri="$SIGNALLING" connect-to-first-producer=true \
    ! videoconvert ! jpegenc ! multifilesink location="$WORK/f-%05d.jpg" \
    >"$WORK/gst.log" 2>&1 &
GST=$!

got=""
for _ in $(seq 1 "$DEADLINE"); do
    # Take the SECOND-newest frame: multifilesink is still writing the newest, so
    # copying it can capture a truncated JPEG that fails a decode-based gate for
    # a reason that has nothing to do with the stream.
    n=$(ls -1 "$WORK"/*.jpg 2>/dev/null | wc -l)
    if [ "$n" -ge 2 ]; then
        got=$(ls -1t "$WORK"/*.jpg 2>/dev/null | sed -n 2p)
        [ -s "$got" ] && break
        got=""
    fi
    sleep 1
done

kill "$GST" 2>/dev/null
wait "$GST" 2>/dev/null

if [ -z "$got" ]; then
    echo "FRAME-FAIL: no frame arrived over WebRTC within ${DEADLINE}s"
    echo "--- consumer log ---"
    tail -20 "$WORK/gst.log" 2>/dev/null
    exit 1
fi

cp "$got" "$OUT"
echo "FRAME-OK: $(stat -c%s "$OUT") bytes from $(ls -1 "$WORK"/*.jpg 2>/dev/null | wc -l) received"
