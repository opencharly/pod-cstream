#!/bin/bash
# Drive one PAM login attempt through the real session leader and report a
# machine-checkable verdict. The password goes over stdin, never argv.
#
# Both outcomes are asserted by the bed, and the failing leg is the one that
# carries the evidence: a probe that only ever checks the CORRECT password
# passes just as happily against a PAM stack that accepts anything, which is
# precisely the regression a login gate exists to catch.
set -u
user="$1"; expect="$2"; pw="$3"
out=$(printf '%s\n' "$pw" | /usr/local/bin/cstream-leader cstream "$user" 2>&1); rc=$?
case "$expect:$rc" in
    accept:0) echo "LOGIN-ACCEPTED user=$user" ;;
    accept:*) echo "LOGIN-UNEXPECTED-REJECT user=$user rc=$rc out=$out"; exit 1 ;;
    reject:0) echo "LOGIN-UNEXPECTED-ACCEPT user=$user -- a wrong password was admitted"; exit 1 ;;
    reject:1) echo "LOGIN-REJECTED user=$user" ;;
    reject:*) echo "LOGIN-BAD-EXIT user=$user rc=$rc out=$out"; exit 1 ;;
esac
